pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- global variables for collision points (debug)
c1x, c2x, cy = 0, 0, 0
c21x, c22x, c2y = 0, 0, 0

function _init()
    -- physics
    gravity = 0.3
    max_fall_speed = 4

    -- animation
    w = false         -- walking flag
    d = 2             -- frame delay
    s = 1             -- current sprite
    blink_timer = 0
    blink_interval = 120 -- ~2 sec
    blinking = false

    plr = {
        x = 30, y = 30,
        dx = 0, dy = 0,
        f = false,               -- facing left
        on_ground = false,
        jump_strength = -3.4,
        -- collision offsets
        g1x = 1, g2x = 6, gy = 8,      -- feet
        g21x = 1, g22x = 6, g2y = 3    -- sides
    }
end

function is_solid(tile)
    return tile == 70 or tile == 71 or tile == 72 or tile == 73 or tile == 74 or tile == 75
        or tile == 90 or tile == 91
        or tile == 68 or tile == 69
        or tile == 84 or tile == 85 or tile == 88 or tile == 89
        or tile == 100 or tile == 101
        or tile == 116 or tile == 38 or tile == 39 or tile == 54 or tile == 55
        or tile == 104 or tile == 105
        or tile == 120 or tile == 121
        or tile == 108 or tile == 109
        or tile == 124 or tile == 125
       end

-- semi-solid platforms (jump-through from below, land from above)
function is_semi_solid(tile)
    return tile == 76 or tile == 77 or tile == 78 or tile == 79
        or tile == 110 or tile == 111
        or tile == 34 or tile == 35 or tile == 36 or tile == 37
        or tile == 9 or tile == 10
        or tile == 149 or tile == 150
end

function _update()
    camera_follow()
    w = false

    local old_x = plr.x
    local old_y = plr.y

    -- horizontal input
    plr.dx = 0
    if btn(➡️) then
        plr.dx = 1
        plr.f = false
        w = true
    elseif btn(⬅️) then
        plr.dx = -1
        plr.f = true
        w = true
    end

    -- jump input
    if btnp(⬆️) and plr.on_ground or btnp(❎) and plr.on_ground then
        plr.dy = plr.jump_strength
        plr.on_ground = false
    end

    -- apply horizontal move
    plr.x += plr.dx
    update_collision_points()
    local tile_x21 = flr(c21x / 8)
    local tile_x22 = flr(c22x / 8)
    local tile_y2  = flr(c2y / 8)

    if is_solid(mget(tile_x21, tile_y2)) or is_solid(mget(tile_x22, tile_y2)) then
        plr.x = old_x
    end

    -- apply gravity
    plr.dy += gravity
    if plr.dy > max_fall_speed then
        plr.dy = max_fall_speed
    end
    plr.y += plr.dy

    -- vertical collisions
    update_collision_points()
    local tile_x1 = flr(c1x / 8)
    local tile_x2 = flr(c2x / 8)
    local tile_y  = flr(cy / 8)

    local t1 = mget(tile_x1, tile_y)
    local t2 = mget(tile_x2, tile_y)

    local feet_y = plr.y + plr.gy
    local old_feet_y = old_y + plr.gy

    if plr.dy > 0 then
        -- falling
        local solid_hit = is_solid(t1) or is_solid(t2)
        local semi_hit  = is_semi_solid(t1) or is_semi_solid(t2)

        if solid_hit then
            -- snap to top of solid
            plr.y = tile_y*8 - plr.gy
            plr.dy = 0
            plr.on_ground = true
        elseif semi_hit and old_feet_y <= tile_y*8 and not btn(⬇️) and not btn(🅾️) then
            -- land on semi-solid only if above and not pressing down
            plr.y = tile_y*8 - plr.gy
            plr.dy = 0
            plr.on_ground = true
        else
            plr.on_ground = false
        end

    elseif plr.dy < 0 then
        -- jumping upward
        local solid_hit = is_solid(t1) or is_solid(t2)
        if solid_hit then
            -- bonk head on solid block
            plr.y = old_y
            plr.dy = 0
        end
        -- semi-solids ignored when jumping up
    end
    
    check_portal()

    -- animation
    if w then
        walking()
        blink_timer = 0
        blinking = false
    else
        idle_blink()
    end
end

function update_collision_points()
    c1x = plr.x + plr.g1x
    c2x = plr.x + plr.g2x
    cy  = plr.y + plr.gy

    c21x = plr.x + plr.g21x
    c22x = plr.x + plr.g22x
    c2y  = plr.y + plr.g2y
end

function walking()
    d -= 1
    if d < 0 then
        s += 1
        if s > 7 then s = 2 end -- walking frames 2-7
        d = 2
    end
end

function idle_blink()
    blink_timer += 1
    if not blinking and blink_timer > blink_interval then
        s = 23 -- eyes closed
        blinking = true
        blink_timer = 0
    elseif blinking and blink_timer > 10 then
        s = 1 -- back to idle open
        blinking = false
        blink_timer = 0
    else
        if not blinking then s = 1 end
    end
end

-- portal timer
portal_timer = 0
portal_wait = 60  -- 1 second if 60 fps

-- blocks that trigger nether teleport
function is_portal(tile)
    return tile == 25 or tile == 26
        or tile == 41 or tile == 42
        or tile == 57 or tile == 58
        or tile == 9 or tile == 10
end

function check_portal()
    update_collision_points()
    local tile_x1 = flr(c1x / 8)
    local tile_x2 = flr(c2x / 8)
    local tile_y  = flr(cy / 8)

    local t1 = mget(tile_x1, tile_y)
    local t2 = mget(tile_x2, tile_y)

    -- treat obsidian frame as portal surface
    local standing_on_frame = (t1 == 149 or t1 == 150 or t2 == 149 or t2 == 150)

    if is_portal(t1) or is_portal(t2) or standing_on_frame then
        portal_timer += 1
        if portal_timer >= portal_wait then
            -- teleport to nether (move map downwards, adjust as needed)
            plr.y += 275
            portal_timer = 0
        end
    else
        portal_timer = 0
    end
end

function camera_follow()
    local cam_x = plr.x - 60
    local cam_y = plr.y - 60

    -- adjust to map size
    local max_cam_x = 512 -- example
    local max_cam_y = 512

    cam_x = mid(0, cam_x, max_cam_x)
    cam_y = mid(0, cam_y, max_cam_y)

    camera(cam_x, cam_y)
end

function _draw()
    cls()
    map()
    spr(s, plr.x, plr.y, 1, 1, plr.f)

    -- debug points
    --pset(c1x, cy, 8) 
    --pset(c2x, cy, 8)
    --pset(c21x, c2y, 8) 
    --pset(c22x, c2y, 8)
end
